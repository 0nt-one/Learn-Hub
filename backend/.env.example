APP_ENV=development
# 相对 SQLite 路径始终按 backend/ 解析；当前仅配置，不创建数据库。
DATABASE_URL=sqlite:///data/learn_hub.db
# 优先使用 Vite 的同源 /api 代理；需要直接跨域访问时填写精确 origin。
# 示例：["http://127.0.0.1:5173"]
CORS_ORIGINS=[]
# 本地开发时在 .env 中填写随机生成的密钥；不要提交真实密钥。
# 例如使用 PowerShell: [Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET_KEY=

